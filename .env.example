# ─────────────────────────────────────────────────────────────────────
#  Shop Agent — local configuration
#
#  1. Get a key at https://openrouter.ai/keys  (starts with sk-or-v1-)
#  2. Paste it after the = below, with no quotes and no spaces
#  3. Save this file and reload http://localhost:8787 — no restart needed
# ─────────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=

# Optional, separate OpenRouter account/key used only when the primary key
# above runs out of credit — keeps the free fallback model (see server.js's
# FALLBACK_MODEL) working even after that happens. Leave blank to just reuse
# OPENROUTER_API_KEY for the fallback call too.
OPENROUTER_FALLBACK_API_KEY=

# Optional. Leave blank to auto-pick the best model your key can reach.
# Any OpenRouter model id works, e.g.:
#   deepseek/deepseek-v4-pro
#   deepseek/deepseek-v4-flash
#   deepseek/deepseek-v3.2
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Thinking depth for reasoning models (deepseek-v4-pro, o-series, R1, ...).
# low | medium | high | off.  Reasoning models spend tokens thinking BEFORE
# they answer, so this trades answer latency against quality.
OPENROUTER_REASONING=medium

# Ceiling for one response (thinking + answer). Generous on purpose — output
# length is steered by the prompt, not by starving the model.
OPENROUTER_MAX_TOKENS=4000

# Port for the local server (default 8787)
PORT=8787

# --- Agent browser (computer use) -----------------------------------------
# Model that drives the browser. DeepSeek is text-only, so the agent reads
# the page's interactive elements rather than screenshots.
BROWSER_MODEL=deepseek/deepseek-v4-pro
# BROWSER_HEADLESS=1     # hide the Chromium window (live view still works)
# BROWSER_PROFILE=       # where the logged-in session is kept
# BROWSER_START_URL=https://admin.shopify.com/
# Browser driver: playwright (default, + playwright_stealth anti-detection)
# or patchright (stronger in theory, but its Chromium self-exits on this box).
# BROWSER_DRIVER=playwright
# BROWSER_CHANNEL=          # blank = bundled Chromium. "chrome" breaks if you
                            # already have Google Chrome open.

# Accounts + sessions live in MongoDB. A free MongoDB Atlas cluster works:
# Connect > Drivers gives the mongodb+srv://... string. Collections and
# indexes are created on first boot. Blank = local file store in .data/.
MONGODB_URI=
# MONGODB_DB=shop_agent

# Shopify store URL + password (if password-gated) are per-account — each
# user sets their own during onboarding, saved to their account. Nothing to
# configure here.
