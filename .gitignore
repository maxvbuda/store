.DS_Store

# Secrets — the OpenRouter key lives here. Never commit.
.env

# Runtime state: accounts, error log, and the agent's Chromium profile.
# The profile holds live cookies and saved logins — committing it once
# already put them on GitHub.
.data/

# Leftover extraction from the shopify-mcp inspection; not part of the app.
shopify-agent/

# Dependencies and caches
node_modules/
.playwright/
__pycache__/
*.pyc

# app/index.html IS committed — it is generated by build.py but
# Render's Node image has no python3 to regenerate it at deploy time.
